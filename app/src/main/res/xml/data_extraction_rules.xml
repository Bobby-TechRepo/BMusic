<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ cloud backup and device-to-device transfer. Same content as backup_rules.xml:
    settings, equalizer, the library database and imported lyrics; not the device-specific
    playing queue, crash reports or widget state.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/app_settings.json" />
        <include domain="file" path="datastore/equalizer_preferences.json" />
        <include domain="file" path="lyrics" />
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/app_settings.json" />
        <include domain="file" path="datastore/equalizer_preferences.json" />
        <include domain="file" path="lyrics" />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
